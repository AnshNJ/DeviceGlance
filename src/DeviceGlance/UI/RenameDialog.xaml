<Window x:Class="DeviceGlance.UI.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename device"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Loaded="OnLoaded">
    <StackPanel Margin="12">
        <TextBlock x:Name="Prompt" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Width="260" MaxLength="64"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="72" IsDefault="True" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="Cancel" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
