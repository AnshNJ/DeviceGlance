<Window x:Class="DeviceGlance.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DeviceGlance.UI"
        Title="DeviceGlance"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" Width="300"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border CornerRadius="10" Background="#1E1E1E" Padding="12">
        <StackPanel>
            <TextBlock Text="Devices" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
            <TextBlock x:Name="EmptyText" Text="No paired Bluetooth devices" FontSize="12" Foreground="#A0A0A0"
                       Visibility="Collapsed"/>
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:DeviceRowViewModel}">
                        <Grid Margin="0,4" Opacity="{Binding RowOpacity}" ToolTip="{Binding ToolTip}" Background="Transparent">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename…" Click="OnRenameClick"/>
                                    <MenuItem Header="Hide" Click="OnHideClick"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{Binding SubtitleBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x2014;" FontSize="13" Foreground="#A0A0A0"
                                           Visibility="{Binding NoBatteryVisibility}"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding BatteryVisibility}">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               Foreground="#F5A524" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Visibility="{Binding ChargingVisibility}"/>
                                    <ProgressBar Width="60" Height="6" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                 Foreground="{Binding BarBrush}" Background="#3A3A3A" BorderThickness="0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PercentText}" FontSize="13" Foreground="White" Width="40"
                                               TextAlignment="Right" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
